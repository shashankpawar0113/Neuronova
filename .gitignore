# =============================================================================
# NeuroNova — Root .gitignore
# =============================================================================

# ─── Secrets & Environment Files ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
# Keep example files (they contain only placeholders, never real keys)
!.env.example

# ─── Credentials & Private Keys ───────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json
*serviceAccount*.json
*service_account*.json
client_secret*.json
gcloud-service-account*.json

# ─── Database Files (may contain patient PII) ─────────────────────────────────
*.db
*.sqlite
*.sqlite3
Neuronovai/data/

# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Build Output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Test Scratch Scripts (local-only, not part of production code) ───────────
Neuronovai/scratch_test_isolation.js
Neuronovai/scripts/

# ─── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Vite / Rollup Cache ──────────────────────────────────────────────────────
.vite/
*.local

# ─── Miscellaneous ────────────────────────────────────────────────────────────
scratch/
