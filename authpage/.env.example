# authpage/.env.example — SAFE TO COMMIT (contains no real secrets)
# Copy this file to .env.local and fill in your Firebase project values.
#
# Firebase Web SDK credentials are intentionally browser-accessible.
# Security is enforced by:
#   1. Firebase Security Rules (Firestore + Auth)
#   2. Restricting the API key to your domain in Google Cloud Console:
#      https://console.cloud.google.com/apis/credentials
#
# Get these values from Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Inter-service URLs (local dev default — replace with deployed URL in production)
VITE_AUTHPAGE_URL=http://localhost:5174
VITE_HOMEPAGE_URL=http://localhost:5175
VITE_NEUROMUSIC_URL=http://localhost:5177
VITE_NEUROGAMES_URL=http://localhost:5178
VITE_CAREGIVERPAGE_URL=http://localhost:5179
VITE_BACKEND_URL=http://localhost:5001
