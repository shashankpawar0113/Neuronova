# =============================================================================
# NeuroNova AI & Media Backend Service — Environment Variable Reference
# =============================================================================
# This file is SAFE TO COMMIT. It contains only placeholders.
# Copy this to .env and fill in your real values. Never commit .env.
# =============================================================================

# Port for the backend service
PORT=5001

# OpenRouter API Key — SERVER-SIDE ONLY, never expose to browser
# Get a new key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model identifier (not a secret)
OPENROUTER_MODEL=z-ai/glm-5.2:free

# YouTube Data API v3 Key — SERVER-SIDE ONLY, never expose to browser
# Get a key from https://console.cloud.google.com/apis/credentials
# Security recommendations:
#   - Restrict this key to "YouTube Data API v3" only
#   - Restrict by IP address (your server's IP) if deployed
YOUTUBE_API_KEY=your_youtube_api_key_here

# CORS allowed origins (comma-separated)
# In development, use the comma-separated localhost URLs below. In production, set to your real deployed domains.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5175,http://127.0.0.1:5177,http://127.0.0.1:5178,http://127.0.0.1:5179

# Inter-service URLs (local dev default — replace with deployed URL in production)
AUTHPAGE_URL=http://localhost:5174
HOMEPAGE_URL=http://localhost:5175
NEUROMUSIC_URL=http://localhost:5177
NEUROGAMES_URL=http://localhost:5178
CAREGIVERPAGE_URL=http://localhost:5179
BACKEND_URL=http://localhost:5001
